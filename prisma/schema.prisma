generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERARIO
  TESTER
}

enum WorkerType {
  INTERNAL
  EXTERNAL
}

enum LaborBillingMode {
  INTERNAL_INCLUDED
  HOURLY
}

enum ProductType {
  RAW_MATERIAL
  PREPARED_MATERIAL
  FINISHED_PRODUCT
  SERVICE
}

enum InventoryMovementType {
  OPENING_BALANCE
  ENTRY
  EXIT
  ADJUSTMENT
}

enum TechniqueRule {
  UN_FACTOR
  DOS_FACTORES
  SIMPLE
}

enum FiringStage {
  LOW
  HIGH
}

enum FiringType {
  SHARED
  EXCLUSIVE
}

enum QuotationStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum CostStatus {
  READY
  COST_INCOMPLETE
}

enum ImportStatus {
  PREVIEW
  CONFIRMED
  FAILED
}

enum AssistantKnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssistantSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  displayName   String
  passwordHash  String
  role          Role                @default(TESTER)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  auditEvents   AuditEvent[]
  movements     InventoryMovement[]
  importBatches ImportBatch[]
  quotations    Quotation[]
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String            @unique
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model PosCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  parentId  String?
  parent    PosCategory?  @relation("PosCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  PosCategory[] @relation("PosCategoryTree")
  products  Product[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  code               String?             @unique
  internalReference  String?             @unique
  name               String
  productType        ProductType         @default(FINISHED_PRODUCT)
  categoryId         String?
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posCategoryId      String?
  posCategory        PosCategory?        @relation(fields: [posCategoryId], references: [id], onDelete: SetNull)
  salesTax           Decimal?            @db.Decimal(8, 6)
  purchaseTax        Decimal?            @db.Decimal(8, 6)
  canSell            Boolean             @default(true)
  canBuy             Boolean             @default(false)
  posAvailable       Boolean             @default(false)
  salePrice          Decimal?            @db.Decimal(24, 12)
  unitCost           Decimal?            @db.Decimal(24, 12)
  costPerGram        Decimal?            @db.Decimal(27, 15)
  costUnit           String?
  unit               String              @default("und")
  purchaseUnit       String?
  isStockable        Boolean             @default(true)
  // Optional piece sheet used to autocomplete the quoter for finished products.
  lengthCm           Decimal?            @db.Decimal(24, 12)
  widthCm            Decimal?            @db.Decimal(24, 12)
  heightCm           Decimal?            @db.Decimal(24, 12)
  clayWeightG        Decimal?            @db.Decimal(24, 12)
  defaultClayId      String?
  defaultClay        Product?            @relation("ProductDefaultClay", fields: [defaultClayId], references: [id], onDelete: SetNull)
  defaultGlazeId     String?
  defaultGlaze       Product?            @relation("ProductDefaultGlaze", fields: [defaultGlazeId], references: [id], onDelete: SetNull)
  clayFor            Product[]           @relation("ProductDefaultClay")
  glazeFor           Product[]           @relation("ProductDefaultGlaze")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  movements          InventoryMovement[]
  outputRecipe       Recipe?             @relation("RecipeOutput")
  recipeItems        RecipeItem[]        @relation("RecipeIngredient")
  techniques         ProductTechnique[]
  quotationItems     QuotationItem[]
  quotationMaterials QuotationMaterial[]

  @@index([name])
  @@index([categoryId])
  @@index([productType, isActive])
}

model Contact {
  id                   String    @id @default(cuid())
  displayName          String
  identificationType   String?
  identificationNumber String?   @unique
  street               String?
  district             String?
  province             String?
  department           String?
  country              String?
  email                String?
  phone                String?
  bankAccount          String?
  bankName             String?
  roles                String[]  @default([])
  isActive             Boolean   @default(true)
  customer             Customer?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([displayName])
  @@index([email])
}

model Customer {
  id           String      @id @default(cuid())
  code         String?     @unique
  contactId    String?     @unique
  contact      Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  displayName  String
  customerType String      @default("PORMENOR")
  isActive     Boolean     @default(true)
  quotations   Quotation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([displayName])
  @@index([customerType])
}

model Location {
  id        String              @id @default(cuid())
  name      String              @unique
  isActive  Boolean             @default(true)
  movements InventoryMovement[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventoryMovement {
  id            String                @id @default(cuid())
  code          String?               @unique
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId    String
  location      Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(24, 12)
  unit          String
  reason        String?
  sourceKey     String?               @unique
  importBatchId String?
  importBatch   ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([productId, locationId, createdAt])
  @@index([importBatchId])
}

model Recipe {
  id              String       @id @default(cuid())
  outputProductId String       @unique
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id], onDelete: Cascade)
  yieldQuantity   Decimal      @db.Decimal(24, 12)
  yieldUnit       String
  items           RecipeItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model RecipeItem {
  id                  String  @id @default(cuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredientProduct   Product @relation("RecipeIngredient", fields: [ingredientProductId], references: [id], onDelete: Restrict)
  quantity            Decimal @db.Decimal(24, 12)
  unit                String

  @@index([recipeId])
  @@index([ingredientProductId])
}

model Worker {
  id              String               @id @default(cuid())
  code            String?              @unique
  name            String
  workerType      WorkerType           @default(INTERNAL)
  billingMode     LaborBillingMode     @default(INTERNAL_INCLUDED)
  dailyRate       Decimal?             @db.Decimal(24, 12)
  hoursPerDay     Decimal?             @default(8) @db.Decimal(8, 3)
  isActive        Boolean              @default(true)
  techniques      WorkerTechnique[]
  defaultProducts ProductTechnique[]
  laborTasks      QuotationLaborTask[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([name])
}

model Technique {
  id         String               @id @default(cuid())
  code       String?              @unique
  name       String               @unique
  rule       TechniqueRule        @default(SIMPLE)
  factor1    Decimal?             @db.Decimal(24, 12)
  factor2    Decimal?             @db.Decimal(24, 12)
  cycleRate  Decimal?             @db.Decimal(24, 12)
  isActive   Boolean              @default(true)
  workers    WorkerTechnique[]
  products   ProductTechnique[]
  laborTasks QuotationLaborTask[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model WorkerTechnique {
  workerId        String
  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  techniqueId     String
  technique       Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  factor1Override Decimal?  @db.Decimal(24, 12)
  factor2Override Decimal?  @db.Decimal(24, 12)
  productivityOverride Decimal? @db.Decimal(12, 6)
  rateOverride    Decimal?  @db.Decimal(24, 12)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@id([workerId, techniqueId])
}

model ProductTechnique {
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  techniqueId     String
  technique       Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  defaultWorkerId String?
  defaultWorker   Worker?   @relation(fields: [defaultWorkerId], references: [id], onDelete: SetNull)
  order           Int       @default(0)
  isRequired      Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@id([productId, techniqueId])
}

model Kiln {
  id          String            @id @default(cuid())
  code        String?           @unique
  name        String            @unique
  class       String?
  capacityCm3 Decimal           @db.Decimal(24, 12)
  lowRate     Decimal           @db.Decimal(24, 12)
  highRate    Decimal           @db.Decimal(24, 12)
  isActive    Boolean           @default(true)
  firings     QuotationFiring[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CommercialSettings {
  id                      String   @id @default("default")
  glazeDefaultPct         Decimal  @default(0.15) @db.Decimal(8, 6)
  separationXcm           Decimal  @default(3) @db.Decimal(8, 3)
  separationYcm           Decimal  @default(3) @db.Decimal(8, 3)
  separationZcm           Decimal  @default(3) @db.Decimal(8, 3)
  productionFactorDefault Decimal  @default(3) @db.Decimal(12, 6)
  productionFactorMin     Decimal  @default(2) @db.Decimal(12, 6)
  igvRate                 Decimal  @default(0.18) @db.Decimal(8, 6)
  rentPerDay              Decimal  @default(110) @db.Decimal(24, 12)
  utilitiesPerDay         Decimal  @default(10) @db.Decimal(24, 12)
  administrativeCost      Decimal  @default(200) @db.Decimal(24, 12)
  hoursPerCycle           Decimal  @default(8) @db.Decimal(8, 3)
  validityDays            Int      @default(30)
  dayAdjustments          Json     @default("[]")
  // NONE keeps the V2 workbook result; UP_* rounds the pre-tax price up to the step.
  priceRounding           String   @default("NONE")
  defaultFiringType       String   @default("SHARED")
  defaultLowFiringEnabled Boolean  @default(true)
  defaultHighFiringEnabled Boolean @default(true)
  defaultLowKilnId        String?
  defaultHighKilnId       String?
  updatedAt               DateTime @updatedAt
}

model CompanyProfile {
  id               String   @id @default("default")
  legalName        String?
  tradeName        String?
  ruc              String?
  address          String?
  addressReference String?
  ubigeoCode       String?
  department       String?
  province         String?
  district         String?
  country          String?
  postalCode       String?
  phone            String?
  mobile           String?
  email            String?
  website          String?
  contactName      String?
  contactRole      String?
  updatedAt        DateTime @updatedAt
}

model CompanyLogo {
  id        String   @id @default("default")
  data      Bytes
  mimeType  String
  fileName  String?
  size      Int
  sha256    String
  updatedAt DateTime @updatedAt
}

model DocumentSettings {
  id                String   @id @default("default")
  showLogo          Boolean  @default(true)
  showLegalName     Boolean  @default(true)
  showRuc           Boolean  @default(true)
  showAddress       Boolean  @default(true)
  showPhones        Boolean  @default(true)
  showEmail         Boolean  @default(true)
  showWebsite       Boolean  @default(true)
  validityText      String?
  conditions        String?
  observations      String?
  estimatedTime     String?
  paymentTerms      String?
  bankName          String?
  bankAccountHolder String?
  bankAccount       String?
  bankCci           String?
  closingMessage    String?
  showSignature     Boolean  @default(false)
  signatureName     String?
  signatureRole     String?
  updatedAt         DateTime @updatedAt
}

model NumberSequence {
  key         String   @id
  label       String
  prefix      String
  padding     Int      @default(6)
  yearly      Boolean  @default(false)
  currentYear Int?
  lastValue   Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}

model Quotation {
  id               String           @id @default(cuid())
  code             String?          @unique
  status           QuotationStatus  @default(DRAFT)
  costStatus       CostStatus       @default(READY)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  validityDays     Int              @default(30)
  productionFactor Decimal          @db.Decimal(12, 6)
  productionDays   Decimal          @db.Decimal(12, 6)
  materialCost     Decimal?         @db.Decimal(24, 12)
  laborCost        Decimal?         @db.Decimal(24, 12)
  firingCost       Decimal?         @db.Decimal(24, 12)
  technicalCost    Decimal?         @db.Decimal(24, 12)
  otherCosts       Decimal?         @db.Decimal(24, 12)
  subtotal         Decimal?         @db.Decimal(24, 12)
  igvRate          Decimal          @db.Decimal(8, 6)
  igvAmount        Decimal?         @db.Decimal(24, 12)
  total            Decimal?         @db.Decimal(24, 12)
  unitPrice        Decimal?         @db.Decimal(24, 12)
  inputSnapshot    Json
  economicSnapshot Json?
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            QuotationItem[]
  totals           QuotationTotals?

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model QuotationItem {
  id            String               @id @default(cuid())
  quotationId   String
  quotation     Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  quantity      Decimal              @db.Decimal(24, 12)
  moldCount     Int                  @default(1)
  productionTimePerCycleMinutes Decimal @default(480) @db.Decimal(10, 3)
  lengthCm      Decimal?             @db.Decimal(24, 12)
  widthCm       Decimal?             @db.Decimal(24, 12)
  heightCm      Decimal?             @db.Decimal(24, 12)
  clayWeightG   Decimal              @db.Decimal(24, 12)
  materials     QuotationMaterial[]
  laborTasks    QuotationLaborTask[]
  firings       QuotationFiring[]
  materialCost  Decimal?             @db.Decimal(24, 12)
  laborCost     Decimal?             @db.Decimal(24, 12)
  firingCost    Decimal?             @db.Decimal(24, 12)
  unitPrice     Decimal?             @db.Decimal(24, 12)
  lineTotal     Decimal?             @db.Decimal(24, 12)
  inputSnapshot Json
  createdAt     DateTime             @default(now())
}

model QuotationMaterial {
  id              String        @id @default(cuid())
  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  materialType    String
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String?
  quantity        Decimal       @db.Decimal(24, 12)
  unit            String
  appliedUnitCost Decimal?      @db.Decimal(27, 15)
  cost            Decimal?      @db.Decimal(24, 12)
}

model QuotationLaborTask {
  id              String        @id @default(cuid())
  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  workerId        String?
  worker          Worker?       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  techniqueId     String
  technique       Technique     @relation(fields: [techniqueId], references: [id], onDelete: Restrict)
  workerName      String?
  techniqueName   String
  quantity        Decimal       @db.Decimal(24, 12)
  factor1         Decimal?      @db.Decimal(24, 12)
  factor2         Decimal?      @db.Decimal(24, 12)
  cycles          Decimal?      @db.Decimal(24, 12)
  calculatedHours Decimal?      @db.Decimal(24, 12)
  appliedHours    Decimal?      @db.Decimal(24, 12)
  rateOverride    Decimal?      @db.Decimal(24, 12)
  rate            Decimal?      @db.Decimal(24, 12)
  cost            Decimal?      @db.Decimal(24, 12)
}

model QuotationFiring {
  id              String        @id @default(cuid())
  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  stage           FiringStage
  firingType      FiringType
  kilnId          String?
  kiln            Kiln?         @relation(fields: [kilnId], references: [id], onDelete: SetNull)
  kilnName        String?
  capacityCm3     Decimal?      @db.Decimal(24, 12)
  tariff          Decimal?      @db.Decimal(24, 12)
  occupancy       Decimal?      @db.Decimal(12, 8)
  batches         Decimal?      @db.Decimal(24, 12)
  volumeCm3       Decimal       @db.Decimal(24, 12)
  cost            Decimal?      @db.Decimal(24, 12)
}

model QuotationTotals {
  quotationId      String    @id
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  materialCost     Decimal?  @db.Decimal(24, 12)
  laborCost        Decimal?  @db.Decimal(24, 12)
  firingCost       Decimal?  @db.Decimal(24, 12)
  technicalCost    Decimal?  @db.Decimal(24, 12)
  productionFactor Decimal   @db.Decimal(12, 6)
  productionDays   Decimal   @db.Decimal(12, 6)
  otherCosts       Decimal?  @db.Decimal(24, 12)
  subtotal         Decimal?  @db.Decimal(24, 12)
  igvRate          Decimal   @db.Decimal(8, 6)
  igvAmount        Decimal?  @db.Decimal(24, 12)
  total            Decimal?  @db.Decimal(24, 12)
  unitPrice        Decimal?  @db.Decimal(24, 12)
}

model ImportBatch {
  id          String              @id @default(cuid())
  fileName    String
  sha256      String              @unique
  status      ImportStatus        @default(PREVIEW)
  preview     Json
  rawData     Json
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  movements   InventoryMovement[]
  errors      ImportError[]
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([status, createdAt])
}

model ImportError {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sheet      String
  rowNumber  Int?
  severity   String
  code       String
  message    String
  resolution String?
  createdAt  DateTime    @default(now())

  @@index([batchId, severity])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

model AssistantKnowledgeEntry {
  id          String                   @id @default(cuid())
  slug        String
  title       String
  content     String                   @db.Text
  tags        String[]                 @default([])
  module      String?
  step        String?
  adminOnly   Boolean                  @default(false)
  version     Int
  status      AssistantKnowledgeStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime                 @default(now())
  suggestions AssistantKnowledgeSuggestion[]

  @@unique([slug, version])
  @@index([status, module, step])
}

model AssistantKnowledgeSuggestion {
  id               String                    @id @default(cuid())
  question         String                    @db.Text
  proposedAnswer   String?                   @db.Text
  route            String
  module           String
  step             String?
  status           AssistantSuggestionStatus @default(PENDING)
  submittedById    String?
  reviewedById     String?
  reviewNote       String?
  knowledgeEntryId String?
  knowledgeEntry   AssistantKnowledgeEntry?  @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now())
  reviewedAt       DateTime?

  @@index([status, createdAt])
}

model AssistantInteraction {
  id        String   @id @default(cuid())
  userId    String
  question  String   @db.Text
  answer    String   @db.Text
  route     String
  module    String
  step      String?
  entityId  String?
  resolved  Boolean  @default(true)
  costSensitive Boolean @default(false)
  createdAt DateTime @default(now())
  feedback  AssistantFeedback?

  @@index([userId, createdAt])
  @@index([resolved, createdAt])
}

model AssistantFeedback {
  id            String               @id @default(cuid())
  interactionId String               @unique
  interaction   AssistantInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  userId        String
  helpful       Boolean
  reason        String?              @db.Text
  createdAt     DateTime             @default(now())

  @@index([userId, createdAt])
}

model QuotationOutcome {
  id                  String   @id @default(cuid())
  quotationId         String
  productTypes        Json
  quantity            Decimal  @db.Decimal(24, 12)
  dimensions          Json
  materials           Json
  moldCount           Int
  workers             Json
  techniques          Json
  activeHours         Decimal? @db.Decimal(24, 12)
  firingConfiguration Json
  estimatedCost       Decimal? @db.Decimal(24, 12)
  finalCost           Decimal? @db.Decimal(24, 12)
  estimatedTime       Decimal? @db.Decimal(24, 12)
  actualTime          Decimal? @db.Decimal(24, 12)
  notes               String?  @db.Text
  resultQuality       String?
  outcomeDate         DateTime @default(now())
  createdById         String?
  createdAt           DateTime @default(now())

  @@index([outcomeDate, quantity])
  @@index([quotationId, outcomeDate])
}

model FiringOutcome {
  id              String    @id @default(cuid())
  kilnId          String?
  kilnName        String?
  firingType      FiringType
  volumeCm3       Decimal   @db.Decimal(24, 12)
  capacityCm3     Decimal   @db.Decimal(24, 12)
  occupancyRatio  Decimal   @db.Decimal(12, 8)
  quantity        Decimal   @db.Decimal(24, 12)
  productTypes    Json
  materials       Json
  estimatedCost   Decimal?  @db.Decimal(24, 12)
  realCost        Decimal?  @db.Decimal(24, 12)
  durationMinutes Decimal?  @db.Decimal(24, 12)
  damagedPieces   Int       @default(0)
  observations    String?   @db.Text
  outcomeDate     DateTime  @default(now())
  createdById     String?
  createdAt       DateTime  @default(now())

  @@index([kilnId, firingType, outcomeDate])
  @@index([volumeCm3, capacityCm3])
}

model RecommendationEvent {
  id                String         @id @default(cuid())
  recommendationType String
  entityType        String
  entityId          String?
  estimatedSaving   Decimal?       @db.Decimal(24, 12)
  sourceCases       Json           @default("[]")
  confidence        ConfidenceLevel
  accepted          Boolean?
  appliedAt         DateTime?
  scenario          Json?
  userId            String
  createdAt         DateTime       @default(now())
  result            RecommendationResult?

  @@index([entityType, entityId, createdAt])
  @@index([recommendationType, createdAt])
}

model RecommendationResult {
  id                  String              @id @default(cuid())
  recommendationId    String              @unique
  recommendation      RecommendationEvent @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  estimatedSaving     Decimal?            @db.Decimal(24, 12)
  realSaving          Decimal?            @db.Decimal(24, 12)
  estimatedTimeChange Decimal?            @db.Decimal(24, 12)
  realTimeChange      Decimal?            @db.Decimal(24, 12)
  resultQuality       String?
  recordedById        String?
  createdAt           DateTime            @default(now())

  @@index([createdAt])
}

/// Apariencia del login (singleton "default"). Solo guarda parámetros seguros; el frontend genera los estilos.
model LoginAppearance {
  id          String   @id @default("default")
  focalX      Int      @default(50)
  focalY      Int      @default(50)
  overlay     Decimal  @default(0.45) @db.Decimal(3, 2)
  title       String   @default("Cotiza, produce y entrega con orden.")
  highlight   String?  @default("entrega con orden.")
  subtitle    String   @default("Productos, costos, mano de obra y quemas del taller en un solo lugar.")
  showLogo    Boolean  @default(true)
  logoTone    String   @default("LIGHT")
  heroVersion String?
  updatedAt   DateTime @updatedAt
}

/// Imagen del login: el original sin recortar y sus variantes WEBP por ancho.
model LoginHeroAsset {
  variant   String   @id
  mimeType  String
  width     Int
  height    Int
  size      Int
  fileName  String?
  data      Bytes
  createdAt DateTime @default(now())
}
