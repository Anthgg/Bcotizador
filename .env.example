# Copy to .env and replace these local-only placeholders before `docker compose up`.
POSTGRES_PASSWORD=replace-with-a-random-local-password
JWT_SECRET=replace-with-a-long-random-local-jwt-secret
BOOTSTRAP_SECRET=replace-with-a-random-one-time-bootstrap-secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
TRUST_PROXY=1
MAX_UPLOAD_MB=20
